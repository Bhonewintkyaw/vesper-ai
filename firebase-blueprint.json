{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user workspace preferences and identity metadata stored per authenticated user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the owner."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "User display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 200,
          "description": "Verified user email address."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional user avatar URL."
        },
        "defaultModel": {
          "type": "string",
          "enum": ["gemini-4-hydrogen", "gemini-3.1-flash-lite"],
          "description": "Default Gemini model for new threads."
        },
        "defaultThinkingLevel": {
          "type": "string",
          "enum": ["MINIMAL", "LOW", "MEDIUM", "HIGH", "XHIGH"],
          "description": "Default reasoning depth for new threads."
        },
        "defaultSystemInstruction": {
          "type": "string",
          "maxLength": 4000,
          "description": "Default system instruction applied to new conversations."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-update timestamp."
        }
      },
      "required": ["uid", "displayName", "email", "defaultModel", "defaultThinkingLevel", "defaultSystemInstruction", "createdAt", "updatedAt"]
    },
    "ChatThread": {
      "title": "ChatThread",
      "description": "A persistent AI conversation thread owned by a single user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the user who owns this thread."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "description": "Short conversation title."
        },
        "model": {
          "type": "string",
          "enum": ["gemini-4-hydrogen", "gemini-3.1-flash-lite"],
          "description": "Selected Gemini model for this thread."
        },
        "thinkingLevel": {
          "type": "string",
          "enum": ["MINIMAL", "LOW", "MEDIUM", "HIGH", "XHIGH"],
          "description": "Selected reasoning depth for this thread."
        },
        "systemInstruction": {
          "type": "string",
          "maxLength": 4000,
          "description": "Custom system instruction for this thread."
        },
        "useSearch": {
          "type": "boolean",
          "description": "Whether Google Search grounding is enabled."
        },
        "pinned": {
          "type": "boolean",
          "description": "Whether the thread is pinned in the sidebar."
        },
        "messageCount": {
          "type": "integer",
          "description": "Count of messages in the thread."
        },
        "lastMessagePreview": {
          "type": "string",
          "maxLength": 240,
          "description": "Truncated preview of the latest message."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-update timestamp."
        }
      },
      "required": ["ownerId", "title", "model", "thinkingLevel", "systemInstruction", "useSearch", "pinned", "messageCount", "lastMessagePreview", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "An individual user or model message within a conversation thread.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the thread owner."
        },
        "threadId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Parent thread document ID."
        },
        "role": {
          "type": "string",
          "enum": ["user", "model"],
          "description": "Message author role."
        },
        "text": {
          "type": "string",
          "maxLength": 50000,
          "description": "Markdown message body."
        },
        "model": {
          "type": "string",
          "maxLength": 64,
          "description": "Model ID used to generate this message."
        },
        "sources": {
          "type": "array",
          "description": "Bounded list of web grounding citations (max 15).",
          "maxLength": 15
        },
        "attachmentNames": {
          "type": "array",
          "description": "Bounded list of attached filenames (max 5).",
          "maxLength": 5
        },
        "totalTokens": {
          "type": "integer",
          "description": "Optional token usage count reported by Gemini."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["ownerId", "threadId", "role", "text", "createdAt"]
    },
    "VesperModule": {
      "title": "VesperModule",
      "description": "User-defined custom function or module extending Vesper AI capabilities.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the user who owns this module."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Module display name."
        },
        "command": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^/[a-z0-9_\\-]+$",
          "description": "Slash command trigger for this module."
        },
        "description": {
          "type": "string",
          "maxLength": 200,
          "description": "Short summary of what the module does."
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "System instruction injected when the module is active or invoked."
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether the module is enabled in Vesper's active workflow."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-update timestamp."
        }
      },
      "required": ["ownerId", "name", "command", "description", "instruction", "enabled", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-only user profile and default chatbot preferences."
    },
    "/users/{userId}/threads/{threadId}": {
      "schema": { "$ref": "#/entities/ChatThread" },
      "description": "Conversation threads belonging to the user."
    },
    "/users/{userId}/threads/{threadId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Messages belonging to a specific conversation thread."
    },
    "/users/{userId}/modules/{moduleId}": {
      "schema": { "$ref": "#/entities/VesperModule" },
      "description": "Custom modular functions created by the user for Vesper AI."
    }
  }
}
